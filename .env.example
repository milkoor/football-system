# ============================================
# 足球博彩数据系统 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并修改相应值
# cp .env.example .env
# ============================================

# ============================================
# PostgreSQL 数据库配置
# ============================================
POSTGRES_USER=football
POSTGRES_PASSWORD=football_secure_pass
POSTGRES_DB=football_data
# 数据库连接 URL（Docker 内部使用 postgres 作为主机名）
DATABASE_URL=postgresql://football:football_secure_pass@postgres:5432/football_data

# ============================================
# 系统 A：FastAPI 后端配置
# ============================================
# API 主机和端口
API_HOST=0.0.0.0
API_PORT=8000
# API 标题和版本
API_TITLE=足球数据系统 A API
API_VERSION=1.0.0

# ============================================
# 系统 B：Streamlit 前端配置
# ============================================
# 系统 A API 地址（Docker 内部使用 system_a 作为主机名）
SYSTEM_A_API_URL=http://system_a:8000
# Streamlit 端口
STREAMLIT_SERVER_PORT=8501

# ============================================
# 爬虫配置（系统 A）
# ============================================
# 并发爬取数量
CRAWL_CONCURRENCY=3
# 请求延迟范围（秒）
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
# 批量大小
BATCH_SIZE=10

# ============================================
# 代理配置（可选）
# ============================================
# 是否启用代理
PROXY_ENABLED=false
# 代理类型: socks5, http, oxylabs
PROXY_TYPE=socks5
PROXY_HOST=
PROXY_PORT=0
PROXY_USERNAME=
PROXY_PASSWORD=

# ============================================
# 目标网站配置
# ============================================
TITAN_BASE_URL=https://vip.titan007.com
TITAN_SCHEDULE_URL=https://zq.titan007.com

# ============================================
# 定时任务配置（系统 B）
# ============================================
# 自动同步间隔（小时）
SYNC_INTERVAL_HOURS=24
# 是否启用自动同步
SYNC_ENABLED=true

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO

# ============================================
# CORS 配置（可选）
# ============================================
# CORS_ORIGINS=http://localhost:8501,http://localhost:8000